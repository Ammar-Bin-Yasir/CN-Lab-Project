* { font-family: 'Inter', 'Segoe UI', sans-serif; font-size: 14px; color: #e6e7ef; }
QMainWindow, QDialog { background: #202127; }
QWidget#rail { background: #121318; border-right: 1px solid #303139; }
QWidget#sidebar { background: #191a20; border-right: 1px solid #303139; }
QWidget#main { background: #202127; }
QFrame#card { background: #282930; border: 1px solid #373842; border-radius: 12px; }
QLabel { background: transparent; }
QLabel#muted { color: #a9abbc; font-size: 12px; }
QLabel#title { font-size: 26px; font-weight: 700; }
QLabel#brand { font-size: 20px; font-weight: 800; color: #b5aaff; }
QLabel#error { color: #ffaaaa; }
QPushButton { background: #30313b; border: 1px solid transparent; padding: 10px 14px; border-radius: 8px; text-align: left; }
QPushButton:hover { background: #3c3d4a; }
QPushButton:pressed { background: #474858; }
QPushButton:focus, QLineEdit:focus, QTextEdit:focus { border: 1px solid #aa9cff; }
QPushButton:disabled { color: #8b8c9b; background: #25262d; }
QPushButton#primary { background: #7864df; color: white; font-weight: 600; }
QPushButton#primary:hover { background: #8b77f0; }
QPushButton#nav { background: transparent; }
QPushButton#nav:checked { background: #363044; color: #d9d0ff; border-left: 3px solid #a99aff; }
QPushButton#railButton { text-align: center; font-weight: 700; font-size: 17px; padding: 0; }
QPushButton#railButton:checked { background: #7864df; }
QLineEdit, QTextEdit { background: #17181e; border: 1px solid #3a3b46; border-radius: 8px; padding: 10px; selection-background-color: #7864df; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 8px; }
QScrollBar::handle:vertical { background: #555562; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QToolTip { color: #eeeeff; background: #30313b; border: 1px solid #555562; padding: 5px; }

QFrame#voiceMessage { background: #2b2939; border: 1px solid #413b58; border-radius: 14px; }
QLabel#voiceTitle { font-size: 14px; font-weight: 600; }
QPushButton#voicePlay { color: #181322; font-size: 17px; background: #9a87ef; border-radius: 20px; padding: 0; text-align: center; }
QPushButton#voicePlay:hover { background: #b3a1ff; }
QPushButton#voicePlay:disabled { color: #c3b8d2; background: #514765; }
QPushButton#voiceSave { color: #c8c0e0; font-size: 22px; text-align: center; background: transparent; padding: 4px; border-radius: 8px; }
QPushButton#voiceSave:hover { background: #413b58; }
